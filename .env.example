# Cloud: enter each of these as an environment variable / "Variable" in your host.
# Mac:   copy this file to ~/.wa-crm/.env (chmod 600).
# Never commit the real values.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Apple ID email + an app-specific password from
# appleid.apple.com > Sign-In and Security > App-Specific Passwords
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=

# Notion: create an internal integration at https://www.notion.so/my-integrations,
# share a page with it, then run:  python -m wa_crm setup-notion --parent-page <page id>
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---- Cloud only ----
WA_CRM_TIMEZONE=Asia/Kuala_Lumpur
WA_CRM_RUN_AT=21:00
WA_ACCOUNTS=whatsapp,business
# Phone numbers with country code, digits only. Used to show a pairing code in the logs.
WA_PHONE_WHATSAPP=
WA_PHONE_BUSINESS=
# Optional: dry = preview a run in the logs right after each deploy; real = do a real run
RUN_ON_START=
