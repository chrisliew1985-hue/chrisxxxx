# --- Meta WhatsApp Cloud API ---------------------------------------------
# A string you invent. You type the same value into Meta's webhook setup form.
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string

# Meta app dashboard > WhatsApp > API Setup. Use a permanent System User token,
# not the 24-hour temporary one.
WHATSAPP_ACCESS_TOKEN=

# The "Phone number ID" on the same screen — a long number, NOT your phone number.
WHATSAPP_PHONE_NUMBER_ID=

# Meta app dashboard > App settings > Basic > App Secret.
# Used to prove incoming webhooks really came from Meta.
WHATSAPP_APP_SECRET=

# Graph API version. Bump when Meta deprecates the current one.
GRAPH_API_VERSION=v21.0

# --- Claude ----------------------------------------------------------------
# Leave blank to run on keyword rules only (no AI replies, no API cost).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Behaviour -------------------------------------------------------------
PORT=3000

# Stop auto-replying to one contact after this many replies in an hour.
MAX_REPLIES_PER_HOUR=12

# How long the bot stays quiet in a chat after handing it to a human.
HANDOFF_PAUSE_HOURS=12

# Conversation turns remembered per contact.
HISTORY_TURNS=12

# Set to true only while debugging — it writes customer messages to your logs.
LOG_MESSAGE_BODIES=false
