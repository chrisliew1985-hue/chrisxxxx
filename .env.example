# Copy to ~/.wa-crm/.env  (chmod 600). Never commit the real file.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Apple ID email + an app-specific password from
# appleid.apple.com > Sign-In and Security > App-Specific Passwords
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=

# Notion: create an internal integration at https://www.notion.so/my-integrations,
# share a page with it, then run:  python -m wa_crm setup-notion --parent-page <page id>
NOTION_TOKEN=
NOTION_DATABASE_ID=
